{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/index.ts", "scripts/bin/*.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "config/**/*.ts"],
  "ignore": ["scripts/src/tasks/**", "scripts/src/utils/ci-workflow-parser.ts"],
  "ignoreBinaries": ["husky", "tsc", "tsx", "vitest"],
  "ignoreDependencies": ["constants-check", "husky", "jscpd", "prettier", "tsx"]
}
